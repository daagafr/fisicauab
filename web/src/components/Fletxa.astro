---
// Fletxa dels enllaços. `sortida` (↗) per als que marxen del web; si no, →.
interface Props {
	sortida?: boolean;
}
const { sortida = false } = Astro.props;
---

<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="fletxa">
	{sortida ? <path d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10" /> : <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" />}
</svg>
