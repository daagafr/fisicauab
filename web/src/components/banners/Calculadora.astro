---
// Calculadora de laboratori — recrea l'app (feta amb Streamlit, en tema clar): la
// barra lateral gris amb les dues pàgines, el títol en Source Sans, les pestanyes
// amb el subratllat vermell, el resultat dins de la caixa verda i el botó vermell.
// El càlcul que ensenya és el de l'exemple de l'app. Colors mesurats de l'app.
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/source-sans-3/700.css';
import type { Entrada } from '../../data/phihub';

interface Props {
	entrada: Entrada;
}
const { entrada: e } = Astro.props;
---

<a class="st" href={e.url} target="_blank" rel="noopener">
	<span class="st-barra" aria-hidden="true">
		<span class="st-pagina actiu"><span class="st-ico">▭</span>Incertidumbres</span>
		<span class="st-pagina"><span class="st-ico">▦</span>Hoja de datos</span>
		<span class="st-ajust">Cifras significativas</span>
		<span class="st-lliscador"><span></span></span>
	</span>

	<span class="st-cos">
		<span class="st-tipus">{e.tipus} · Streamlit</span>
		<h3 class="st-titol">{e.nom}</h3>
		<span class="st-pestanyes" aria-hidden="true">
			<span class="actiu">Medidas repetidas</span>
			<span>Propagación</span>
			<span>Formulario</span>
		</span>
		<p class="st-desc">{e.descripcio}</p>
		<span class="st-resultat" aria-hidden="true">T = (2.002 ± 0.013) s</span>
		<span class="st-boto">
			{e.cta ?? 'Obre la calculadora'} <span aria-hidden="true">↗</span>
		</span>
	</span>
	<span class="visualment-amagat">(s’obre en una pestanya nova)</span>
</a>

<style>
	.st {
		--vermell: #ff4b4b;
		--text: #31333f;
		--gris: #6b6e7d;
		--barra: #f0f2f6;
		--actiu: #dadfe9;
		--verd-fons: #e8f9ee;
		--verd: #158237;
		--vora: #e2e4ea;

		display: flex;
		height: 100%;
		container-type: inline-size;
		overflow: hidden;
		border: 1px solid var(--vora);
		border-radius: 10px;
		background: #fff;
		box-shadow: 0 1px 2px rgb(49 51 63 / 0.05), 0 8px 24px -12px rgb(49 51 63 / 0.2);
		color: var(--text);
		font-family: 'Source Sans 3', 'Source Sans Pro', system-ui, sans-serif;
		text-decoration: none;
		transition:
			transform 0.2s,
			box-shadow 0.2s;
	}
	.st:hover {
		transform: translateY(-3px);
		box-shadow: 0 2px 4px rgb(49 51 63 / 0.06), 0 18px 36px -16px rgb(49 51 63 / 0.3);
		color: var(--text);
	}

	/* La barra lateral, només si hi cap. */
	.st-barra {
		display: none;
		flex: none;
		flex-direction: column;
		gap: 0.25rem;
		width: 9.5rem;
		padding: 1.4rem 0.75rem;
		background: var(--barra);
		font-size: 0.82rem;
	}
	@container (min-width: 25rem) {
		.st-barra {
			display: flex;
		}
	}
	.st-pagina {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.5rem;
		border-radius: 6px;
		color: var(--gris);
	}
	.st-pagina.actiu {
		background: var(--actiu);
		color: var(--text);
		font-weight: 600;
	}
	.st-ico {
		font-size: 0.8rem;
		line-height: 1;
	}
	.st-ajust {
		margin-top: 1.1rem;
		padding-top: 0.9rem;
		border-top: 1px solid var(--vora);
		color: var(--gris);
		font-size: 0.75rem;
	}
	.st-lliscador {
		position: relative;
		height: 4px;
		margin: 0.6rem 0.2rem 0;
		border-radius: 2px;
		background: linear-gradient(90deg, var(--vermell) 42%, #d5d8e0 42%);
	}
	.st-lliscador span {
		position: absolute;
		top: 50%;
		left: 42%;
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 50%;
		background: var(--vermell);
		translate: -50% -50%;
	}

	.st-cos {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.7rem;
		min-width: 0;
		padding: 1.4rem 1.4rem 1.3rem;
	}
	.st-tipus {
		color: var(--gris);
		font-size: 0.82rem;
	}
	.st-titol {
		margin: 0;
		font-size: 1.6rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1.15;
	}
	.st-pestanyes {
		display: flex;
		gap: 1rem;
		overflow: hidden;
		border-bottom: 1px solid var(--vora);
		color: var(--text);
		font-size: 0.82rem;
		white-space: nowrap;
	}
	.st-pestanyes span {
		padding-bottom: 0.35rem;
	}
	.st-pestanyes .actiu {
		box-shadow: inset 0 -2px 0 var(--vermell);
		color: var(--vermell);
	}
	.st-desc {
		margin: 0;
		color: var(--gris);
		font-size: 0.95rem;
		line-height: 1.45;
	}
	.st-resultat {
		padding: 0.65rem 0.9rem;
		border-radius: 8px;
		background: var(--verd-fons);
		color: var(--verd);
		font-size: 1.15rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}
	.st-boto {
		display: inline-flex;
		align-items: center;
		align-self: flex-start;
		gap: 0.4em;
		margin-top: auto;
		padding: 0.5rem 0.9rem;
		border-radius: 8px;
		background: var(--vermell);
		color: #fff;
		font-size: 0.95rem;
		font-weight: 600;
	}
	.st:hover .st-boto {
		background: #ff2b2b;
	}

	@media (prefers-reduced-motion: reduce) {
		.st {
			transition: none;
		}
		.st:hover {
			transform: none;
		}
	}
</style>
