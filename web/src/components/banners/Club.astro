---
// Club de Física UAB — recrea la portada de clubdefisicauab.cat: foto del Club
// sota un vel blau nit, etiqueta i «UAB» en or, títol molt gruixut i botó-píndola
// d'or. Colors i mesures copiats de custom.css del seu web.
import type { Entrada } from '../../data/phihub';

interface Props {
	entrada: Entrada;
}
const { entrada: e } = Astro.props;
const domini = new URL(e.url!).hostname.replace(/^www\./, '');
---

<a class="cf" href={e.url} target="_blank" rel="noopener">
	<div class="cf-marc">
		<img class="cf-foto" src="/phihub/club-pissarra.jpg" alt="" loading="lazy" decoding="async" />
		<span class="cf-vel" aria-hidden="true"></span>
		<img class="cf-logo" src="/phihub/club-logo-blanc.png" alt="" width="320" height="320" loading="lazy" />

		<div class="cf-dins">
			<p class="cf-etiqueta">Universitat Autònoma de Barcelona</p>
			<h3 class="cf-titol">Club de Física <span>UAB</span></h3>
			<p class="cf-text">{e.descripcio}</p>
			<div class="cf-accions">
				<span class="cf-boto">
					{e.cta ?? 'Coneix el Club'}
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.3 5.3a1 1 0 0 1 1.4 0l6 6a1 1 0 0 1 0 1.4l-6 6a1 1 0 0 1-1.4-1.4l4.3-4.3H4a1 1 0 1 1 0-2h13.6l-4.3-4.3a1 1 0 0 1 0-1.4Z" /></svg>
				</span>
				<span class="cf-domini">{domini}</span>
			</div>
		</div>
	</div>
	<span class="visualment-amagat">(s’obre en una pestanya nova)</span>
</a>

<style>
	.cf {
		--blau-nit: #0b1538;
		--or: #eab308;
		--or-hover: #facc15;
		--ombra: 0 1px 2px rgba(11, 21, 56, 0.05), 0 12px 32px -20px rgba(11, 21, 56, 0.35);
		--ombra-hover: 0 2px 6px rgba(11, 21, 56, 0.08), 0 28px 50px -24px rgba(11, 21, 56, 0.5);

		display: block;
		height: 100%;
		container-type: inline-size;
		border-radius: 16px;
		background: var(--blau-nit);
		box-shadow: var(--ombra);
		color: #fff;
		font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
		text-decoration: none;
		transition:
			transform 0.25s,
			box-shadow 0.25s;
	}
	.cf:hover {
		transform: translateY(-3px);
		box-shadow: var(--ombra-hover);
		color: #fff;
	}

	.cf-marc {
		position: relative;
		isolation: isolate;
		display: flex;
		height: 100%;
		min-height: 20rem;
		overflow: hidden;
		border-radius: inherit;
	}
	.cf-foto {
		position: absolute;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 70% 30%;
		transform: scale(1.05);
		transition: transform 6s ease-out;
	}
	.cf:hover .cf-foto {
		transform: scale(1);
	}
	/* El vel de la seva portada: fosc a l'esquerra, on va el text. */
	.cf-vel {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(90deg, rgba(11, 21, 56, 0.94) 0%, rgba(11, 21, 56, 0.8) 42%, rgba(11, 21, 56, 0.25) 82%, rgba(11, 21, 56, 0.1) 100%),
			linear-gradient(0deg, rgba(11, 21, 56, 0.75) 0%, rgba(11, 21, 56, 0) 40%);
	}
	@container (max-width: 34rem) {
		.cf-vel {
			background: linear-gradient(0deg, rgba(11, 21, 56, 0.96) 38%, rgba(11, 21, 56, 0.5) 100%);
		}
	}

	.cf-logo {
		position: absolute;
		top: 1.1rem;
		right: 1.1rem;
		width: clamp(3.5rem, 14cqi, 5rem);
		height: auto;
		opacity: 0.95;
	}

	.cf-dins {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		width: 100%;
		padding: clamp(1.5rem, 6cqi, 2.5rem);
	}
	.cf-etiqueta {
		margin: 0 0 0.65rem;
		color: var(--or);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		line-height: 1.3;
		text-transform: uppercase;
	}
	.cf-titol {
		max-width: 12ch;
		color: #fff;
		font-size: clamp(2.1rem, 9cqi, 3.6rem);
		font-weight: 900;
		line-height: 1;
		letter-spacing: -0.03em;
	}
	.cf-titol span {
		color: var(--or);
	}
	.cf-text {
		max-width: 30rem;
		margin-top: 1rem;
		color: rgba(255, 255, 255, 0.86);
		font-size: 1rem;
		line-height: 1.55;
	}
	.cf-accions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
		margin-top: 1.5rem;
	}
	.cf-boto {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.75rem 1.35rem;
		border-radius: 999px;
		background: var(--or);
		box-shadow: 0 10px 24px -12px rgba(234, 179, 8, 0.9);
		color: var(--blau-nit);
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.2;
		white-space: nowrap;
		transition:
			background-color 0.2s,
			transform 0.2s;
	}
	.cf-boto svg {
		width: 1.1em;
		height: 1.1em;
		fill: currentColor;
		transition: transform 0.2s;
	}
	.cf:hover .cf-boto {
		background: var(--or-hover);
		transform: translateY(-2px);
	}
	.cf:hover .cf-boto svg {
		transform: translateX(4px);
	}
	.cf-domini {
		color: rgba(255, 255, 255, 0.7);
		font-size: 0.85rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.cf,
		.cf *,
		.cf-foto {
			transition: none !important;
		}
		.cf:hover,
		.cf:hover .cf-boto {
			transform: none;
		}
	}
</style>
