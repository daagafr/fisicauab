---
// Les sigles d'una entrada dins d'un cercle tenyit del color del seu calaix. Si
// l'entrada té logo propi (`imatge`), surt el logo.
interface Props {
	sigles: string;
	imatge?: string;
	color?: string; // un color de calaix: 'blau', 'taronja'…
}
const { sigles, imatge, color = 'blau' } = Astro.props;
const llarg = sigles.length > 2;
---

<span class:list={['monograma', { llarg }]} style={`--c: var(--${color})`} aria-hidden="true">
	{imatge ? <img src={imatge} alt="" loading="lazy" /> : <span>{sigles}</span>}
</span>

<style>
	.monograma {
		position: relative;
		display: grid;
		place-items: center;
		flex: none;
		width: 3.25rem;
		aspect-ratio: 1;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
		border-radius: 50%;
		background: color-mix(in srgb, var(--c) 10%, var(--superficie));
		color: color-mix(in srgb, var(--c) 75%, var(--tinta));
		font-family: var(--lletra-titol);
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: 0.02em;
	}
	.monograma.llarg {
		font-size: 0.75rem;
	}
	.monograma img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
