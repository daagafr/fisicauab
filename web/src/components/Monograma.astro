---
// Les sigles d'una entrada dins d'un cercle del color del seu calaix, amb un filet
// interior com el segell. Si l'entrada té logo propi (`imatge`), surt el logo.
interface Props {
	sigles: string;
	imatge?: string;
	color?: string; // un color de marcador: 'groc', 'blau'…
}
const { sigles, imatge, color = 'groc' } = Astro.props;
const llarg = sigles.length > 2;
---

<span class:list={['monograma', { llarg }]} style={`--c: var(--${color})`} aria-hidden="true">
	{imatge ? <img src={imatge} alt="" loading="lazy" /> : <span>{sigles}</span>}
</span>

<style>
	.monograma {
		position: relative;
		display: grid;
		place-items: center;
		flex: none;
		width: 3.25rem;
		aspect-ratio: 1;
		overflow: hidden;
		border-radius: 50%;
		background: var(--c);
		color: var(--tinta);
		font-size: 1rem;
		font-weight: 800;
		letter-spacing: 0.02em;
	}
	.monograma.llarg {
		font-size: 0.75rem;
	}
	.monograma img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
