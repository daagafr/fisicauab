		transform-origin: 222.6px 214px;
	}
	@media (prefers-reduced-motion: no-preference) {
		.obre path {
			animation: lotus-obre 1.3s cubic-bezier(0.2, 0.75, 0.25, 1) both;
			animation-delay: calc(0.25s + var(--c) * 0.11s);
		}
	}
	@keyframes lotus-obre {
		from {
			opacity: 0;
			transform: rotate(var(--r)) scale(0.55);
		}
		35% {
			opacity: 1;
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
</style>
