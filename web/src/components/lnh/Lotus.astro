---
// El lotus de la portada de La Nostra Història, tal com surt a Recursos/Portada.pdf
// (vectoritzat de la imatge original, sense redibuixar-lo). Cada pètal és un
// traçat a part: amb `obre`, la flor s'obre del centre cap enfora en carregar.
//
//   <Lotus class="..." />            decoratiu
//   <Lotus obre titol="Lotus" />     animat i amb nom per als lectors de pantalla
interface Props {
	class?: string;
	obre?: boolean;
	titol?: string;
}
const { class: classe, obre = false, titol } = Astro.props;
